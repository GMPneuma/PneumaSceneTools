<section class="ap-scanner-body">
  <div class="ap-top {{#if hasRollCard}}ap-top-with-roll{{/if}}">
    <div class="ap-top-left">
  <header class="ap-header"><strong><i class="fas fa-map-location-dot" aria-hidden="true"></i> {{sceneName}}</strong><label class="ap-scene-color">Undefined Scene NetArch Color<input type="color" name="unassignedColor" value="{{unassignedColor}}" title="Color for APs using Undefined Scene NetArch"></label>{{#if hasResult}}<span class="ap-result">Scanner check: {{result}}</span>{{/if}}<button type="button" class="ap-hide-all" data-action="hide-all" title="Hide every AP on this scene from all players, hide names, and stop all pulses"><i class="fas fa-eye-slash" aria-hidden="true"></i> Hide All AP's</button></header>
    <div class="ap-top-controls">
      <div class="ap-controls-heading"><h3 class="ap-section-title"><i class="fas fa-tower-broadcast" aria-hidden="true"></i> Scanner controls</h3></div>
      <div class="ap-runner-row"><label class="ap-runner-field">Netrunner token<select name="runner"><option value="">Choose Netrunner…</option>{{#each runners}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>
      <label class="ap-player-owned"><input type="checkbox" name="playerOwnedOnly" {{#if playerOwnedOnly}}checked{{/if}}> only player tokens</label></div>
      <label class="ap-radius-field"><span>Filter by distance({{units}}) from selected NetRunner. <small>zero = show all</small></span><input type="number" name="radius" value="{{radius}}" min="0" step="any"></label>
    </div>
    </div>
    {{#if hasRollCard}}<section class="ap-roll-preview" aria-label="Scanner roll"><div class="ap-roll-card chat-log" aria-live="polite">Loading Scanner roll…</div></section>{{/if}}
  </div>
  <div class="ap-discovery-title"><h3 class="ap-section-title"><i class="fas fa-network-wired" aria-hidden="true"></i> Access points</h3><span class="ap-selection-count">{{selectedCount}} selected</span></div>
  <div class="ap-list-header" aria-label="Access point column headers"><table class="ap-control-table {{#unless showRevealAll}}ap-hide-reveal-all{{/unless}}"><colgroup><col class="ap-col-select"><col class="ap-col-name"><col class="ap-col-net"><col class="ap-col-distance"><col>{{#each bulkControls}}<col class="ap-col-toggle">{{/each}}</colgroup><thead><tr><th aria-label="Select"></th><th>Access Point</th><th>NetArch</th><th>Distance<br>({{units}})</th><th>Revealed to</th><th class="ap-toggle">Reveal to:<br><span class="ap-dynamic-name" title="{{runnerName}}">{{runnerName}}</span></th>{{#if showRevealAll}}<th class="ap-toggle">Reveal<br>to all</th>{{/if}}<th class="ap-toggle">Pulse <span class="ap-dynamic-label">{{pulseCount}}</span> {{pulseUnit}}</th><th class="ap-toggle">Pulse<br>forever</th><th class="ap-toggle">Show<br>AP name</th></tr></thead></table></div>
  <div class="ap-list">
    <table class="ap-control-table {{#unless showRevealAll}}ap-hide-reveal-all{{/unless}}"><colgroup><col class="ap-col-select"><col class="ap-col-name"><col class="ap-col-net"><col class="ap-col-distance"><col>{{#each bulkControls}}<col class="ap-col-toggle">{{/each}}</colgroup>

      <tbody>{{#each rows}}<tr {{#unless visible}}hidden{{/unless}}>
        <td><input type="checkbox" data-ap-select="{{id}}" aria-label="Select {{name}}" {{#if selected}}checked{{/if}}></td>
        <td><div class="ap-name-edit"><button type="button" class="ap-icon-button" data-action="edit" data-ap-id="{{id}}" title="Edit {{name}}" aria-label="Edit {{name}}"><i class="fas fa-pen-to-square"></i></button><button type="button" class="ap-name-button" data-action="locate" data-ap-id="{{id}}" title="Locate on scene">{{name}}</button></div><small>{{type}}</small></td>
        <td><span class="ap-swatch" style="background-color: {{color}}"></span>{{netarch}}</td>
        <td class="ap-distance">{{distanceText}}</td><td title="{{statusTitle}}">{{status}}</td>
        {{#each controls}}<td class="ap-toggle"><input type="checkbox" data-control="{{key}}" data-group="{{group}}" data-ap-id="{{apId}}" aria-label="{{label}}: {{name}}" {{#if checked}}checked{{/if}}></td>{{/each}}
      </tr>{{/each}}</tbody>
    </table>
    {{#unless hasRows}}<p class="ap-empty">Drag an AP template from the Actors folder onto this scene to begin.</p>{{/unless}}
  </div>
  <footer class="ap-bulk-bar" aria-label="Bulk access point controls">
    <table class="ap-control-table {{#unless showRevealAll}}ap-hide-reveal-all{{/unless}}"><colgroup><col class="ap-col-select"><col class="ap-col-name"><col class="ap-col-net"><col class="ap-col-distance"><col>{{#each bulkControls}}<col class="ap-col-toggle">{{/each}}</colgroup>
      <tbody><tr><td colspan="2" class="ap-footer-selection"><div class="ap-selection-tools"><button type="button" data-action="select-visible">Select All Shown</button><button type="button" data-action="clear">Clear Selection</button></div></td><td colspan="2" class="ap-bulk-label"><strong>Apply to selected</strong></td><td class="ap-bulk-apply"><button type="button" data-action="apply" {{#unless canApply}}disabled{{/unless}}>Apply</button></td>
        {{#each bulkControls}}<td class="ap-toggle"><input type="checkbox" data-control="{{key}}" data-group="{{group}}" title="{{label}} for selected access points" aria-label="{{label}} for selected access points" {{#if checked}}checked{{/if}}></td>{{/each}}
      </tr></tbody>
    </table>
  </footer>
  <p class="notes">{{visibleCount}} of {{totalCount}} APs in the radius filter. Row changes apply immediately. Uncheck to hide or stop. A dash means selected APs differ; Apply changes only the options you adjust.</p>
  <p class="notes">Pulses are visible to everyone who can see the AP.</p>
</section>

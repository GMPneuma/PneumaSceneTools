<section class="pneuma-map-pins">
  <form class="pin-bulk-style">
    <p>Apply to {{count}} selected pins. Blank fields remain unchanged.</p>
    <div class="pin-bulk-columns">
      <aside class="pin-bulk-targets"><h3>Selected pins ({{count}})</h3><ul>{{#each pins}}<li>{{name}}</li>{{/each}}</ul></aside>
      <div class="pin-bulk-controls">
    <div class="form-group"><label>Icon size (pixels)</label><div class="form-fields"><input type="number" name="size" min="16" max="256" step="1" placeholder="Unchanged"></div></div>
    <div class="form-group"><label>Icon color</label><div class="form-fields"><input name="tint" placeholder="Unchanged" aria-label="Icon color"><input type="color" data-pin-color="tint" value="#ffffff" aria-label="Choose icon color"></div></div>
    <div class="form-group"><label>Font family</label><div class="form-fields"><select name="fontFamily"><option value="">Unchanged</option>{{#each fonts}}<option value="{{value}}">{{label}}</option>{{/each}}</select></div></div>
    <div class="form-group"><label>Font size</label><div class="form-fields"><input type="number" name="fontSize" min="1" step="1" placeholder="Unchanged"></div></div>
    <div class="form-group"><label>Font color</label><div class="form-fields"><input name="textColor" placeholder="Unchanged" aria-label="Font color"><input type="color" data-pin-color="textColor" value="#ffffff" aria-label="Choose font color"></div></div>
    <div class="form-group"><label>Text anchor</label><div class="form-fields"><select name="textAnchor"><option value="">Unchanged</option><option value="0">Center</option><option value="1">Bottom</option><option value="2">Top</option><option value="3">Left</option><option value="4">Right</option></select></div></div>
    <div class="form-group"><label>Globally visible</label><div class="form-fields"><select name="global"><option value="">Unchanged</option><option value="true">Yes</option><option value="false">No</option></select></div></div>
    <div class="form-group"><label>Hover preview</label><div class="form-fields"><select name="hover"><option value="">Unchanged</option><option value="true">Show</option><option value="false">Hide</option></select></div></div>
    <fieldset><legend>Hover headings</legend><select name="sectionsMode"><option value="">Unchanged</option><option value="all">All headings</option><option value="selected">Selected headings</option></select>
      <div class="pin-section-list" hidden>{{#each headings}}<label><input type="checkbox" name="sections" value="{{this}}">{{this}}</label>{{/each}}</div>
      <p class="notes">Description is always included. Selected headings apply wherever they exist on each POI. Journal permissions and secrets still apply.</p>
    </fieldset>
      </div>
    </div>
    <footer class="sheet-footer"><button type="submit"><i class="fas fa-paint-brush"></i> Apply to {{count}} pins</button></footer>
    <p class="pin-error" role="alert"></p>
  </form>
</section>

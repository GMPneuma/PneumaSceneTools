<form class="ap-editor-form" autocomplete="off">
  <div class="form-group">
    <label for="{{appId}}-ap-name">Name</label>
    <input id="{{appId}}-ap-name" type="text" name="name" value="{{name}}" maxlength="120" required autofocus>
  </div>
  <div class="form-group">
    <label>Type</label>
    <select name="type">{{#each types}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
  </div>
  <div class="form-group">
    <label>NET Architecture</label>
    <div class="form-fields">
      <select name="netarch">
        <option value="" {{#if noNet}}selected{{/if}}>Undefined Scene NetArch</option>
        {{#each nets}}<option value="{{uuid}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
      </select>
      <button type="button" class="ap-icon-button" data-action="open-netarch" title="Open NET Architecture" {{#unless hasNet}}disabled{{/unless}}><i class="fas fa-up-right-from-square"></i></button>
    </div>
  </div>
  <div class="form-group">
    <label>Architecture color</label>
    <input type="color" name="color" value="{{color}}" {{#unless hasNet}}disabled{{/unless}}>
    <p class="notes">Shared by every access point connected to this Architecture.</p>
  </div>
  <footer class="sheet-footer flexrow"><button type="submit"><i class="fas fa-check"></i> Save Access Point</button></footer>
</form>

<form class="pneuma-artwork-manager">
  <div class="artwork-workspace">
    <aside>
      <div class="artwork-toolbar"><input type="search" data-search placeholder="Search categories or folders" aria-label="Search categories"><button type="button" data-action="add"><i class="fas fa-plus"></i> Add</button></div>
      <div class="artwork-list" aria-label="Artwork categories"></div><small data-count></small>
    </aside>
    <section class="artwork-detail">
      <p data-empty>Select or add a category to edit.</p>
      <fieldset class="artwork-editor">
        <legend>Category details</legend>
        <label>Category name<input data-field="name" aria-label="Category name"></label>
        <label>Artwork folder<span class="artwork-folder"><input data-field="folder" aria-label="Artwork folder"><button type="button" data-action="browse" aria-label="Choose folder" title="Choose folder"><i class="fas fa-folder-open"></i></button></span></label>
        <p class="notes">Random artwork from this folder only.</p>
        <div class="artwork-vehicle">
          <label>Footprint <small>(grid squares)</small><span class="artwork-dimensions"><input data-field="width" aria-label="Footprint width" type="number" min="0.1" max="100" step="0.1"><span>x</span><input data-field="height" aria-label="Footprint height" type="number" min="0.1" max="100" step="0.1"></span></label>
          <label>Artwork scale<span class="artwork-scale"><input data-scale-slider aria-label="Artwork scale slider" type="range" min="0.01" max="5" step="0.01"><input data-field="scale" aria-label="Artwork scale" type="number" min="0.01" max="100" step="0.01"></span></label>
        </div>
      </fieldset>
    </section>
    <section class="artwork-preview pneuma-vehicle-seats" aria-label="Sample artwork and seat positions">
      <p data-preview-message role="status"></p>
      <div class="artwork-preview-stage"><div class="vehicle-seat-image" hidden></div></div>
      <div data-seat-controls hidden><label><input type="checkbox" name="snapSeats" checked> Snap to other seats</label><p class="notes">Align nearby rows and columns. Hold Shift to place freely.</p><button type="button" data-action="add-seat">Place a new seat</button><p class="notes">Click artwork to place a seat. Select a marker, then click to move it. Vehicle type controls capacity.</p><div class="vehicle-seat-rows"></div></div>
    </section>
  </div>
  <p role="alert"></p>
  <footer><button type="button" data-action="remove"><i class="fas fa-trash"></i> Remove selected</button><button type="submit"><i class="fas fa-save"></i> Save categories</button></footer>
</form>

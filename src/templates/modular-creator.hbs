<section class="modular-body">
  <fieldset {{#if busy}}disabled{{/if}}>
    {{#unless placementOnly}}    <div class="modular-row"><label for="modular-scene">Scene</label><select id="modular-scene" name="scene"><option value="">New scene</option>{{#each scenes}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select>{{#if layout}}<button type="button" data-action="view">Build on Scene</button>{{/if}}</div>{{/unless}}
    {{#unless layout}}<div class="modular-row"><label for="modular-name">Name</label><input id="modular-name" name="sceneName" value="{{sceneName}}" maxlength="200"><label for="modular-grid">Grid px</label><input id="modular-grid" name="gridSize" type="number" min="50" max="1000" step="1" value="{{gridSize}}"></div>{{/unless}}
    {{#if layout}}<p class="notes">{{#if layout.awaitingFirstTile}}Choose the first tile to set this scene's size.{{else}}Place a tile at space {{column}}, {{row}} on the scene. Image size: {{layout.width}} x {{layout.height}}.{{/if}}</p>{{else}}<p class="notes">Select an image to set the blank scene dimensions. No tile is placed until you choose one on the canvas.</p>{{/if}}
    <div class="modular-row"><label for="modular-collection">Collection</label><select id="modular-collection" name="collection"><option value="">Choose collection</option>{{#each collections}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select><button type="button" data-action="add" title="Add a folder as a collection"><i class="fas fa-folder-plus"></i></button><button type="button" data-action="refresh" {{#unless hasCollection}}disabled{{/unless}} title="Refresh collection"><i class="fas fa-sync"></i></button><button type="button" data-action="forget" {{#unless hasCollection}}disabled{{/unless}} title="Remove collection from picker"><i class="fas fa-trash"></i></button></div>
    <input name="search" type="search" value="{{search}}" placeholder="Filter tiles by filename" aria-label="Filter tiles by filename">
    {{#if needsSize}}<label class="notes"><input type="checkbox" name="showIncompatible" {{#if showIncompatible}}checked{{/if}}> Show incompatible tiles (unavailable for placement)</label>{{/if}}
    <div class="modular-picker">
      <div class="modular-library"><nav class="tabs modular-media-tabs" role="tablist" aria-label="Tile file type"><button type="button" role="tab" data-action="filter-static" class="{{#if staticTab}}active{{/if}}" aria-selected="{{staticTab}}">Static</button><button type="button" role="tab" data-action="filter-animated" class="{{#if animatedTab}}active{{/if}}" aria-selected="{{animatedTab}}">Animated</button></nav><div class="modular-images">{{#each files}}<button type="button" data-action="choose" {{#if incompatible}}disabled title="Image dimensions do not match this scene, or could not be read"{{/if}} data-path="{{path}}" class="modular-image {{#if selected}}selected{{/if}}" aria-label="{{#if ../layout}}Place tile{{else}}Select reference{{/if}}: {{name}}" aria-pressed="{{selected}}" {{#if hidden}}hidden{{/if}}><img {{#if thumbnail}}src="{{thumbnail}}"{{/if}} loading="lazy" decoding="async" alt="" draggable="false"><span class="modular-hover-action" aria-hidden="true">{{#if ../layout}}Place Tile{{else}}Select{{/if}}</span></button>{{/each}}</div>{{#if emptyTab}}<p class="notes">No {{#if animatedTab}}animated{{else}}static{{/if}} tiles in this collection.</p>{{/if}}</div>
      <div class="modular-large-preview">{{#if previewVideo}}<video disablepictureinpicture src="{{preview}}" autoplay muted loop playsinline aria-label="Tile preview"></video>{{else}}<img {{#if preview}}src="{{preview}}"{{else}}hidden{{/if}} alt="Tile preview" draggable="false">{{/if}}<span class="modular-preview-hint" {{#if preview}}hidden{{/if}}>Hover over a tile to preview it.</span></div>
    </div>
    {{#unless layout}}<div class="modular-footer"><button type="button" data-action="create" {{#unless canPlace}}disabled{{/unless}}>Create Blank Scene</button></div>{{/unless}}
  </fieldset>
  <p class="notes modular-status" role="status">{{status}}</p>
</section>

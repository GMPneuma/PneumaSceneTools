<button type="button" data-action="{{action}}" data-id="{{id}}" title="{{label}}" aria-label="{{label}}" {{#if disabled}}disabled{{/if}} {{#if hasPressed}}aria-pressed="{{pressed}}"{{/if}} {{#if hasExpanded}}aria-expanded="{{expanded}}"{{/if}}>{{#if icon}}<i class="fas {{icon}}" aria-hidden="true"></i>{{/if}}{{#if text}}{{text}}{{/if}}</button>

<form class="ap-types-form">
  <p class="notes">Choose names and icons. Disabled types are hidden from new selections; existing access points are preserved.</p>
  <div class="ap-type-head" aria-hidden="true"><span>On</span><span>Icon</span><span>Name</span><span>Artwork</span></div>
  <div class="ap-types-list">
    {{#each types}}<div class="ap-type-row" data-type-row="{{id}}">
      <input type="checkbox" data-field="enabled" aria-label="Enable {{label}}" {{#if enabled}}checked{{/if}}>
      <img class="ap-type-preview" src="{{img}}" alt="{{label}} icon">
      <input type="text" data-field="label" aria-label="Type name" value="{{label}}" maxlength="80" required>
      <div class="ap-type-image"><input type="text" data-field="img" aria-label="Artwork path" value="{{img}}" title="{{img}}" spellcheck="false" required><button type="button" data-action="browse-type" title="Choose artwork" aria-label="Choose artwork"><i class="fas fa-folder-open"></i></button></div>
    </div>{{/each}}
  </div>
  <footer class="ap-type-footer"><button type="button" data-action="add-type"><i class="fas fa-plus"></i> Add Type</button><button type="submit"><i class="fas fa-save"></i> Save Types</button></footer>
</form>
